# ── SQLite Database ──
# Path to the SQLite database file
DB_PATH=data/widtts.db

# ── Envelope Encryption ──
# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=<generate-with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())">

# ── Application ──
APP_SECRET=dev-secret-change-in-production
PORT=8000

# ── Realtime Voice Transport (LiveKit) ──
# Local Docker: ws://localhost:7880 | devkey | secret
# LiveKit Cloud: wss://<your-project>.livekit.cloud | APIxxxxxxxxxxxx | secretxxxxxxxxxxxxxxxx
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_TOKEN_TTL_SECONDS=3600
LIVEKIT_AUDIO_SAMPLE_RATE=16000

# ── Inactivity Timeout (Seconds) ──
# Time in seconds before an idle session with no user speech automatically disconnects
ROOM_INACTIVITY_TIMEOUT_SECONDS=30
