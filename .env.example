# ── PostgreSQL ──
POSTGRES_USER=widtts
POSTGRES_PASSWORD=widtts_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=widtts

# ── Envelope Encryption ──
# Generate with: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_MASTER_KEY

# ── Application ──
APP_SECRET=dev-secret-change-in-production
PORT=8000

# ── Realtime Voice Transport (LiveKit) ──
# LIVEKIT_URL: browser/public-facing URL (returned in token responses)
LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_INTERNAL_URL: backend-container/internal URL (agent connects here inside Docker)
LIVEKIT_INTERNAL_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_TOKEN_TTL_SECONDS=3600
LIVEKIT_AUDIO_SAMPLE_RATE=16000

# ── Agent Token ──
AGENT_TOKEN_TTL_SECONDS=7200

# ── Session Timeout ──
ROOM_INACTIVITY_TIMEOUT_SECONDS=30
