# ── Envelope Encryption ──
# Generate with: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=your_base64_32_byte_master_encryption_key_here

# ── Application ──
APP_SECRET=your_production_app_secret_here
ADMIN_API_KEY=your_secure_admin_api_key_here
ENVIRONMENT=production
PORT=8000
DB_PATH=data/widtts.db

# ── Realtime Voice Transport (LiveKit) ──
# LIVEKIT_URL: Public/Browser WebRTC signaling URL (e.g. wss://livekit.example.com or https://...ngrok-free.dev)
LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_INTERNAL_URL: Internal Docker network URL for agent-to-LiveKit communication
LIVEKIT_INTERNAL_URL=ws://livekit:7880
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_TOKEN_TTL_SECONDS=3600
LIVEKIT_AUDIO_SAMPLE_RATE=16000
AGENT_TOKEN_TTL_SECONDS=7200
ROOM_INACTIVITY_TIMEOUT_SECONDS=60

# ── Ngrok (Optional for remote tunnels) ──
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# =====================================================================
# PLATFORM TUNING KNOBS (All have built-in defaults in knobs.py)
# =====================================================================

# ── Section 3: Voice Activity Detection (Silero VAD) ──
# Minimum continuous speech duration (0.10s / 100ms filters pops/clicks)
VAD_MIN_SPEECH_DURATION=0.10
# Neural network confidence (0.55 filters coughs/breaths)
VAD_ACTIVATION_THRESHOLD=0.55
# Confidence floor below which speech is considered officially ended (hysteresis gap)
VAD_DEACTIVATION_THRESHOLD=0.40
# Silence duration before VAD marks end of speech (0.30s for faster short-word detection)
VAD_MIN_SILENCE_DURATION=0.30
# Audio buffer retained (sec) before trigger point to prevent clipping first syllable
VAD_PREFIX_PADDING_DURATION=0.30
# Max safety buffer ceiling (sec) before forcing a frame flush
VAD_MAX_BUFFERED_SPEECH=60.0
# VAD inference sample rate in Hz
VAD_SAMPLE_RATE=16000
# Run Silero VAD on CPU (<1ms execution, zero GPU VRAM)
VAD_FORCE_CPU=true

# ── Section 4: Turn-Taking & Interruption (Barge-In) ──
# Master toggle for barge-in capability
INTERRUPTION_ENABLED=true
# Interruption mode ('vad' for fast local ONNX execution; 100% reliable on self-hosted LiveKit)
INTERRUPTION_MODE=vad
# Minimum user speaking time before interrupting agent (1.0s filters coughs/breaths)
INTERRUPTION_MIN_DURATION=1.0
# Minimum recognized STT words required before confirming interruption (1 = must have real speech)
INTERRUPTION_MIN_WORDS=1
# Automatically resume TTS speech if momentary noise paused the bot but no user words followed
INTERRUPTION_RESUME_FALSE_INTERRUPTION=true
# Timeout window (sec) to wait for STT words before declaring a false alarm and resuming playback
INTERRUPTION_FALSE_TIMEOUT=1.0
# Backchannel range min/max (sec) for short agreements ('uh-huh', 'yeah') that don't stop the bot
INTERRUPTION_BACKCHANNEL_MIN=0.5
INTERRUPTION_BACKCHANNEL_MAX=1.5
# Discard audio spoken during uninterruptible speech (e.g. farewell)
INTERRUPTION_DISCARD_IF_UNINTERRUPTIBLE=true

# ── Section 5: Endpointing (Turn-Taking Delays) ──
# Endpointing mode ('dynamic' = sentence structure & punctuation aware; 'fixed' = static delay)
ENDPOINTING_MODE=dynamic
# Minimum response delay (sec) after user stops speaking (0.70s / 700ms)
ENDPOINTING_MIN_DELAY=0.7
# Maximum wait time (sec) when user pauses mid-sentence (3.0s)
ENDPOINTING_MAX_DELAY=3.0
# Smoothing factor for dynamic endpointing
ENDPOINTING_ALPHA=0.90

# ── Section 6: Preemptive Generation & Turn Limits ──
# Preemptive generation (saves ~200-400ms per turn by starting LLM early)
PREEMPTIVE_GENERATION_ENABLED=true
# Speculative TTS generation
PREEMPTIVE_TTS_ENABLED=false
# Max speech duration (sec) for speculative generation
PREEMPTIVE_MAX_SPEECH_DURATION=10.0
# Retry attempts on speculative generation failures
PREEMPTIVE_MAX_RETRIES=3

# ── Section 7: AgentSession Core Runtime & Delays ──
# Grace period (sec) after bot starts speaking to ignore self-echo while WebRTC AEC calibrates
AEC_WARMUP_DURATION=1.0
# Timeout (sec) to fire user_transcription_timeout if VAD heard audio but STT got no words
TRANSCRIPTION_TIMEOUT=2.0
# Seconds to wait for final STT tokens when tearing down the session
SESSION_CLOSE_TRANSCRIPT_TIMEOUT=2.0
# Minimum pause (sec) between back-to-back agent speech turns (prevents TTS voice breaking)
MIN_CONSECUTIVE_SPEECH_DELAY=0.05
# Max consecutive tool invocations per turn
MAX_TOOL_STEPS=3
# Sync transcript events with exact TTS audio playback timestamps (false for raw audio streaming)
USE_TTS_ALIGNED_TRANSCRIPT=false
# Text transforms before TTS synthesis to strip markdown and emojis
TTS_TEXT_TRANSFORMS=filter_markdown,filter_emoji
# Delay (sec) before sending greeting to allow WebRTC track negotiation
GREETING_STABILIZATION_DELAY=0.3
# Sleep pause (sec) to allow farewell TTS audio to drain before disconnecting
FAREWELL_DRAIN_DELAY=4.0
# Sleep pause (sec) after publishing session_end data packet before tearing down WebRTC
FAREWELL_PUBLISH_DELAY=0.5

# ── Section 8: Deepgram STT Settings ──
# Deepgram STT endpointing (300ms for faster short-word recognition)
DEEPGRAM_ENDPOINTING_MS=300
STT_SMART_FORMAT=true
STT_PUNCTUATE=true
STT_INTERIM_RESULTS=true

# ── Section 13: Outbound HTTP & Admin Network Timeouts (sec) ──
HTTP_HEALTH_CHECK_TIMEOUT=3.0
HTTP_PROVIDER_VERIFY_TIMEOUT=8.0
HTTP_MODEL_FETCH_TIMEOUT=10.0
