# ── SQLite Database ──
# Path to the SQLite database file (relative to working directory or absolute)
DB_PATH=data/widtts.db

# ── Envelope Encryption ──
# Generate with: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_MASTER_KEY

# ── Application ──
APP_SECRET=dev-secret-change-in-production
PORT=8000

# ── Realtime Voice Transport (LiveKit) ──
# LIVEKIT_URL: browser/public-facing URL (returned to browser in token responses).
# - For local development: ws://localhost:7880 or http://localhost:3000
# - For remote ngrok access: https://your-domain.ngrok-free.app (or wss://...)
LIVEKIT_URL=ws://localhost:7880

# LIVEKIT_INTERNAL_URL: backend-container/internal URL (agent connects here directly inside Docker)
LIVEKIT_INTERNAL_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_TOKEN_TTL_SECONDS=3600
LIVEKIT_AUDIO_SAMPLE_RATE=16000

# ── Agent Token ──
AGENT_TOKEN_TTL_SECONDS=7200

# ── Session Timeout ──
ROOM_INACTIVITY_TIMEOUT_SECONDS=30

# ── ngrok Remote Tunnel (Optional / Required for remote access) ──
# NGROK_AUTHTOKEN: ngrok authentication token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
# NGROK_DOMAIN: Optional static/custom domain (e.g. my-app.ngrok-free.app or my-app.ngrok.app)
# Leave blank for an automatically assigned random ngrok URL
NGROK_DOMAIN=

